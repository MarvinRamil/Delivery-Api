# ============================================================================
# GitLab CI/CD Variables — Bee Logistics Backend (dev + staging)
# Settings > CI/CD > Variables.  Add each KEY / VALUE below.
# ============================================================================
# This is the COMPLETE list of variables you must add manually to a fresh GitLab.
# Everything else the pipeline needs is already handled and does NOT go here:
#   • SECRETS (DB password, JWT secret, Xendit/Email/S3/Zammad/SMS keys,
#     RabbitMQ/Mqtt creds) -> fetched at runtime from HashiCorp Vault (bee/config).
#   • Per-env values (POSTGRES_DB, API_PORT, CONTAINER_NAME, DOCKER_TAG,
#     FRONTEND_URL/BACKOFFICE_URL/API_URL, REDIS_CONTAINER/PORT, RABBITMQ_CONTAINER,
#     MQTT_ENV, MQTT_LOCATION_TOPIC) -> hardcoded in prepare:env:dev / prepare:env:staging.
#   • Shared constants (JWT_ISSUER, JWT_AUDIENCE, JWT_EXPIRY_MINUTES, EMAIL_USE_SSL,
#     MQTT_USE_SSL, MQTT_IGNORE_CERTIFICATE_ERRORS, RABBITMQ_PORT, DOCKER_IMAGE_NAME)
#     -> defined in the top-level `variables:` block of .gitlab-ci.yml.
#
# TIP: use GitLab "Environment scope" to give dev and staging their own
# VAULT_ROLE_ID / VAULT_SECRET_ID. Mark credential values Masked (+ Protected).
# ----------------------------------------------------------------------------


# ====================== REQUIRED — fill these in ============================

# --- Vault bootstrap (the app authenticates with these) ---
VAULT_ADDRESS=https://10.10.10.117:8200
VAULT_ROLE_ID=               # AppRole role_id for THIS environment   (Masked)
VAULT_SECRET_ID=             # AppRole secret_id for THIS environment (Masked, Protected)
VAULT_SKIP_TLS_VERIFY=true   # self-signed cert -> true; set false once Vault has a trusted cert

# --- RabbitMQ bootstrap (the deploy job CREATES the rabbitmq container) ---
# MUST match the RabbitMQ__Username / RabbitMQ__Password stored in Vault bee/config.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- Redis auth (optional; the deploy job CREATES the redis container) ---
# When set, redis is created with --requirepass and the deploy appends
# ",password=..." to the connection strings passed to the app. Leave unset for
# no-auth (current dev/staging behavior). Vault bee/config must NOT contain a
# blank ConnectionStrings__Redis key — it would override this with an empty value.
# Rotating it requires removing the redis container on the VM first (docker rm).
REDIS_PASSWORD=              # (Masked)


# ============== NON-SECRET APP CONFIG (passed by the deploy) ================
# These are not secrets. Values below are the current dev values — adjust per env.
# (If you'd rather not manage them here, they also live in appsettings.json baked
#  into the image; but the deploy passes them explicitly, so set them to avoid
#  overriding the image config with empty strings.)

# Email (password is in Vault)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USERNAME=donotreply@mybeeapp.com
EMAIL_FROM=donotreply@mybeeapp.com

# MQTT (username/password are in Vault)
MQTT_HOST=mqtt.ilocosscript.live
MQTT_PORT=80

# File storage strategy: "S3" and "DigitalOcean" profiles can both be configured; this picks
# which is active and can be changed without a redeploy/restart (access/secret keys are in Vault)
FILE_STORAGE_PROVIDER=DigitalOcean
DIGITALOCEAN_ENDPOINT=https://sgp1.digitaloceanspaces.com/
DIGITALOCEAN_CDN_ENDPOINT=https://bee-dev.sgp1.cdn.digitaloceanspaces.com/
DIGITALOCEAN_REGION=sgp1
DIGITALOCEAN_USE_SSL=true
DIGITALOCEAN_BUCKET_NAME=bee-dev
DIGITALOCEAN_OBJECT_KEY_PREFIX=application-documents/

# ClamAV (antivirus scan)
CLAMAV_ENABLED=false
CLAMAV_HOST=10.10.10.116
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Payment gateways
# Active gateway for NEW payments: paymongo | xendit. Secrets are in Vault:
# PayMongo__SecretKey, PayMongo__WebhookSecret, PayMongo__SourceAccountNumber/Name/Bic
PAYMENTS_ACTIVE_GATEWAY=paymongo
PAYMONGO_BASE_URL=https://api.paymongo.com/
PAYMONGO_CHECKOUT_SUCCESS_URL=https://mybeeapp.com/payment/success
PAYMONGO_CHECKOUT_CANCEL_URL=https://mybeeapp.com/payment/cancelled
PAYMONGO_TRANSFER_PROVIDER=instapay

# Xendit (API key + webhook token are in Vault)
XENDIT_BASE_URL=https://api.xendit.co/

# Zammad (API token is in Vault)
ZAMMAD_BASE_URL=http://100.105.242.96:9080
ZAMMAD_ENABLED=true

# Logging (Seq) — leave empty to disable
SEQ_SERVER_URL=http://10.10.10.92:5341

# SMS (PhilSMS token / Ilocos key are in Vault) — base URLs + sender id only
SMS_ILOCOS_API_BASE_URL=https://sms.ilocosscript.live
PHILSMS_API_BASE_URL=https://dashboard.philsms.com/api/v3
PHILSMS_SENDER_ID=BeeOnDemand

# Booking matching radius (km). prepare:env defaults this to 35 if unset.
PROXIMITY_RADIUS_KM=35


# ===================== OPTIONAL (only if you want it) =======================
# Staging only: disable rate limiting inside the container. Leave unset to keep
# rate limiting ON. Set to "true" to disable.
# FEATURES__DISABLE_RATE_LIMITING=true
