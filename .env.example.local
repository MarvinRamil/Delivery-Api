# ============================================
# BEE LOGISTICS BACKEND - Portainer Environment Variables
# ============================================
# Copy these variables to Portainer's Environment Variables section
# Format: KEY=value (one per line)
# Portainer will automatically apply these to your container

# ============================================
# PostgreSQL Configuration (External VM)
# ============================================
POSTGRES_HOST=100.120.42.59
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bee_logistics_db

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-secret-key-minimum-32-characters-long-for-production-use-a-strong-random-key
JWT_ISSUER=BeeLogisticsApi
JWT_AUDIENCE=BeeLogisticsClient
JWT_EXPIRY_MINUTES=60

# ============================================
# CORS Configuration
# ============================================
FRONTEND_URL=https://mybeeapp.com
BACKOFFICE_URL=https://backoffice.mybeeapp.com
FRONTEND_URL_DEV=http://localhost:3000
BACKOFFICE_URL_DEV=http://localhost:3001

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@beelogistics.com
EMAIL_USE_SSL=true

# ============================================
# Xendit Payment Configuration
# ============================================
XENDIT_API_KEY=your-xendit-api-key
XENDIT_BASE_URL=https://api.xendit.co/
XENDIT_WEBHOOK_TOKEN=your-webhook-secret-token

# ============================================
# MQTT Configuration
# ============================================
MQTT_HOST=mqtt.gregdoesdev.xyz
MQTT_PORT=80
MQTT_USERNAME=ilocosscript
MQTT_PASSWORD=your-mqtt-password

# ============================================
# Environment
# ============================================
ASPNETCORE_ENVIRONMENT=Production

# ============================================
# Docker Compose Environment Variable Mappings
# ============================================
# These are the actual environment variable names used in docker-compose.yml:
# ConnectionStrings__DefaultConnection (built from POSTGRES_* vars)
# ConnectionStrings__Redis=redis:6379 (hardcoded)
# JwtSettings__Secret=
# JwtSettings__Issuer=
# JwtSettings__Audience=
# JwtSettings__ExpiryMinutes=
# Cors__AllowedOrigins__0=
# Cors__AllowedOrigins__1=
# Cors__AllowedOrigins__2=
# Cors__AllowedOrigins__3=
# Email__Host=
# Email__Port=
# Email__Username=
# Email__Password=
# Email__From=
# Email__UseSsl=
# Xendit__ApiKey=
# Xendit__BaseUrl=
# Xendit__WebhookToken=
# Mqtt__Host=
# Mqtt__Port=
# Mqtt__Username=
# Mqtt__Password=
