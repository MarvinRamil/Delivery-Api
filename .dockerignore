# .dockerignore for Development
# Exclude unnecessary files from Docker build context

# Git
.git
.gitignore
.gitattributes

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
bin/
obj/
*.dll
*.pdb
*.exe
*.dll.config

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# NuGet
packages/
*.nupkg
.nuget/

# Environment files
.env
.env.local
.env.*.local

# Documentation
docs/
*.md
!README.md

# Docker files (avoid recursive copies)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Uploads (will be in volume)
wwwroot/uploads/
App_Data/uploads/

# Temporary files
tmp/
temp/
*.tmp
