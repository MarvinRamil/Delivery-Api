# Runtime-only image built by CI (dev).
#
# Unlike Dockerfile, this has no SDK stage: the `publish` CI job already compiled
# the app, so the image is just the ASP.NET runtime plus the publish output. That
# removes a full in-container restore+build (and the ~1GB SDK image pull) from
# every docker build.
#
# The build context is the publish output directory, NOT the repo root:
#   docker build -f Dockerfile.ci -t <tag> publish
# which is also why the COPY below is `COPY . .`.

# MUST match the SDK image the `publish` CI job compiled with, or the app will fail at
# startup with "You must install or update .NET to run this application". The docker
# build passes --build-arg DOTNET_IMAGE_TAG=$DOTNET_IMAGE_TAG so both come from the same
# variable in .gitlab-ci.yml; the default here only matters for manual local builds.
ARG DOTNET_IMAGE_TAG=10.0-preview
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_IMAGE_TAG} AS runtime
WORKDIR /app

# Install curl for healthcheck
# Kept above the COPY so the host daemon can reuse this layer across builds.
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy published files (context is the publish output directory)
COPY . .

# Note: appsettings.json is optional - not in git repo for security
# All configuration comes from environment variables set by the deploy job

# Declare volume for persistent uploads (stored under App_Data/uploads)
VOLUME ["/app/App_Data/uploads"]

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "BeeLogistics.Api.dll"]
