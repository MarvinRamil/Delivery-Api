version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise

loggers:
  synapse.storage.SQL:
    level: WARNING
  # The appservice pushes a transaction per room event; at INFO this is the noisiest logger here.
  synapse.appservice:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
