# Rendered at deploy time — NEVER commit the real file. Add conf/99-secrets.yaml to .gitignore
# (already done) and generate it from Vault/CI variables. See ../README.md for the exact command.
#
# Every value here is a secret. Rotating macaroon_secret_key or form_secret logs every client out;
# rotating the database password does not.

database:
  name: psycopg2
  args:
    user: "synapse"
    password: "REPLACE_FROM_VAULT"
    dbname: "synapse"
    host: "10.10.10.XXX"
    port: 5432
    # Synapse holds these connections open. Keep the ceiling modest — this database shares a
    # server with bee's own, and Synapse will happily saturate it.
    cp_min: 5
    cp_max: 10

# Signs the access tokens Synapse issues. Changing it invalidates every session at once.
macaroon_secret_key: "REPLACE_FROM_VAULT"
# Signs Synapse's own HTML forms. Unused with registration closed, but Synapse refuses to start
# without it.
form_secret: "REPLACE_FROM_VAULT"
