# ============================================
# BEE LOGISTICS BACKEND - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# This file is for docker-compose usage

# ============================================
# HashiCorp Vault (PII/SII encryption keys)
# ============================================
# The backend fetches its AES master key + HMAC blind-index key from Vault at startup
# (KV v2 mount "bee", secret "dpa/encryption"). Create an AppRole and paste its credentials here.
VAULT_ADDRESS=https://10.10.10.117:8200
VAULT_MOUNT_PATH=bee
VAULT_SECRET_PATH=dpa/encryption
# Self-signed Vault cert -> true for dev. Set to false once Vault has a trusted cert (prod).
VAULT_SKIP_TLS_VERIFY=true
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ============================================
# PostgreSQL Configuration (External VM)
# ============================================
POSTGRES_HOST=100.120.42.59
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bee_logistics_db

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-secret-key-minimum-32-characters-long-for-production-use-a-strong-random-key
JWT_ISSUER=BeeLogisticsApi
JWT_AUDIENCE=BeeLogisticsClient
JWT_EXPIRY_MINUTES=60

# ============================================
# Service-to-Service Clients (back-office backend)
# ============================================
# API keys are validated as SHA-256 hashes (lowercase hex). Generate a key with:
#   openssl rand -hex 32
# then hash it:
#   echo -n "<key>" | sha256sum
# ServiceUserId is the seeded Identity user the service acts as (any GUID; keep stable).
ServiceClients__Clients__0__ClientId=backoffice-backend
ServiceClients__Clients__0__ApiKeyHashes__0=<sha256-hex-of-api-key>
ServiceClients__Clients__0__ServiceUserId=00000000-0000-0000-0000-000000000001

# Back-office webhooks (bee-backend -> backoffice-backend, HMAC-signed)
# Generate the secret with: openssl rand -hex 32
BackofficeWebhooks__Enabled=false
BackofficeWebhooks__Endpoint=http://localhost:5340/api/webhooks/bee
BackofficeWebhooks__Secret=<shared-hmac-secret>

# ============================================
# CORS Configuration
# ============================================
# Note: CORS works at the origin level (protocol + domain + port)
# All paths on these domains are automatically included - no need to specify paths
FRONTEND_URL=https://mybeeapp.com
BACKOFFICE_URL=https://backoffice.mybeeapp.com

# Development URLs (optional, for local testing)
FRONTEND_URL_DEV=http://localhost:3000
BACKOFFICE_URL_DEV=http://localhost:3001

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@beelogistics.com
EMAIL_USE_SSL=true

# ============================================
# Payment Gateways
# ============================================
# Active gateway for NEW payments/top-ups/withdrawals: "paymongo" or "xendit".
# Existing records always route by the provider stored on the record, so both
# providers below should stay configured while either has in-flight payments.
PAYMENTS_ACTIVE_GATEWAY=paymongo

# --- Location trail retention ---
# Ages out map.LocationHistory, the driver breadcrumb trail. A single tracking
# driver writes ~1,200 rows/hour, so without this the table grows forever.
# Runs daily off-peak, bounded per run.
LOCATION_RETENTION_ENABLED=true
# Covers operational debugging ("where was this driver during that booking")
# with room for a dispute raised well after delivery. How long evidence must be
# kept is a business/legal call. Startup validation rejects anything under 7.
LOCATION_RETENTION_DAYS=60

# --- Reconciliation ---
# The hourly reconciliation job is detection-only except for one step: it cancels
# provider checkouts abandoned in Pending, so stale links stop being payable.
# This is the only part of that job which changes state at the provider.
#
# Kill switch. Set false to stop expiring checkouts without a redeploy.
PAYMENT_EXPIRE_ABANDONED_CHECKOUTS=true
# How long a payment must sit untouched in Pending before its checkout is treated
# as abandoned. Deliberately generous: expiring a checkout a customer is midway
# through paying is far worse than leaving a dead one open. Any webhook or state
# change refreshes the payment out of the set. Startup validation rejects < 2.
PAYMENT_ABANDONED_CHECKOUT_GRACE_HOURS=12
# How far back the job looks for bookings cancelled while their online payment is still
# Paid - money the customer has not got back. Detection only; it counts and alerts.
# 168h matches the refund window: older than that a refund needs a human anyway.
PAYMENT_CANCELLED_BOOKING_AUDIT_LOOKBACK_HOURS=168

# --- Automatic refunds on cancellation ---
# Refunds a cancelled booking's online payment without anyone asking. OFF, deliberately.
# Two things have to be known first: how PayMongo actually settles a refund (synchronously,
# or Pending plus a later webhook), and how often this happens at all - watch the metric
# bee.payments.cancelled_unrefunded before flipping this.
#
# The risk it guards against: a customer who also charges back with their bank gets paid
# twice, and nothing here ingests disputes, so we cannot tell. When on, it refunds only
# cancellations nobody caused (no driver ever accepted) and only while the payment is still
# inside PAYMENT refund window - an older payment stays manual so a human can check the
# provider dashboard for a dispute first.
PAYMENT_AUTO_REFUND_CANCELLED_BOOKINGS=false

# --- PayMongo ---
# Secret API key. MUST start with sk_test_ or sk_live_ — a whsk_... value is the webhook
# signing secret, not a key, and authenticates nothing (every call 401s with
# {"code":"unauthorized","detail":"failed to get organization"}). Startup validation
# rejects the wrong prefix rather than letting it fail silently at runtime.
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
PAYMONGO_BASE_URL=https://api.paymongo.com/
# Webhook signing secret (whsk_...) returned when creating the webhook via POST v1/webhooks
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-secret
# Hosted checkout redirect URLs (required by PayMongo checkout sessions)
PAYMONGO_CHECKOUT_SUCCESS_URL=https://mybeeapp.com/payment/success
PAYMONGO_CHECKOUT_CANCEL_URL=https://mybeeapp.com/payment/cancelled
# Disbursement rail: instapay (instant, <= PHP 50k) or pesonet (larger amounts)
PAYMONGO_TRANSFER_PROVIDER=instapay
# Where PayMongo POSTs transfer status changes. Optional — leave empty and the
# driver-withdrawal-reconcile job resolves statuses by polling instead.
PAYMONGO_TRANSFER_CALLBACK_URL=
# Merchant source account for outbound transfers (driver withdrawals) — the PayMongo
# wallet account money is sent FROM. Read them from GET /v2/wallets:
#   ./scripts/paymongo-source-account.sh      (prints the three lines below, filled in)
# or by hand:
#   curl -sL https://api.paymongo.com/v2/wallets/ -u "$PAYMONGO_SECRET_KEY:" | jq
# Note the trailing slash (the API 301s without it, and curl drops auth across the
# redirect unless -L is given) and the colon after the key (empty password; without it
# curl stops to prompt for one).
# The BIC is PAEYPHM2XXX for PayMongo wallets. Leave all three empty to disable payouts;
# with PAYMENTS_ACTIVE_GATEWAY=paymongo that means every driver withdrawal fails.
PAYMONGO_SOURCE_ACCOUNT_NUMBER=
PAYMONGO_SOURCE_ACCOUNT_NAME=
PAYMONGO_SOURCE_ACCOUNT_BIC=

# --- Xendit ---
XENDIT_API_KEY=your-xendit-api-key
XENDIT_BASE_URL=https://api.xendit.co/
XENDIT_WEBHOOK_TOKEN=your-webhook-secret-token
# RSA public key (Base64) for webhook signature verification (optional if token is set)
XENDIT_PUBLIC_KEY=REPLACE_WITH_XENDIT_PUBLIC_KEY

# ============================================
# MQTT Configuration
# ============================================
MQTT_HOST=mqtt.gregdoesdev.xyz
MQTT_PORT=80
MQTT_USERNAME=ilocosscript
MQTT_PASSWORD=your-mqtt-password

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# Deployment isolation (#79). The broker is shared infrastructure, and MassTransit derives queue
# names from consumer type names with no prefix - so without a vhost every deployment binds the
# SAME queues and RabbitMQ round-robins between them, silently splitting messages between
# deployments that then answer them against different databases.
# The vhost must exist and the user must have permissions on it; the deploy job does that with
# `rabbitmqctl add_vhost` + `set_permissions`. Blank means the default vhost "/".
RABBITMQ_VHOST=dev

# ============================================
# Redis / SignalR isolation (#79)
# ============================================
# Redis is shared. REDIS_DB scopes CACHE KEYS by appending ,defaultDatabase=N to the connection
# string - 0 is left free, dev uses 1.
REDIS_DB=1
# Redis pub/sub is NOT database-scoped, so REDIS_DB does nothing for the SignalR backplane. Without
# its own channel prefix, a BookingStatusChanged broadcast in one deployment reaches that user's
# connections in another. Falls back to "BeeLogistics:signalr:" when unset, i.e. the old shared
# behaviour, so forgetting this degrades rather than breaks.
SIGNALR_CHANNEL_PREFIX=BeeLogistics:signalr:dev:

# ============================================
# Zammad Helpdesk
# ============================================
ZAMMAD_BASE_URL=http://10.10.10.91:9080
ZAMMAD_API_TOKEN=your-zammad-api-token
# HMAC secret for webhook signature verification; must match Zammad webhook "HMAC SHA1 Signature Token"
ZAMMAD_WEBHOOK_SECRET=your-webhook-hmac-secret
# Zammad group each ticket type is filed into. The group - not the customer's organization -
# is what makes a ticket visible to agents and populates its Owner dropdown. Any group named
# here must grant the Agent role full permission first, otherwise the tickets arrive where
# nobody can see them.
ZAMMAD_CUSTOMER_GROUP=BeeOnDemand - Customer
ZAMMAD_DRIVER_GROUP=BeeOnDemand - Driver

# ============================================
# Environment
# ============================================
ASPNETCORE_ENVIRONMENT=Production

# ============================================
# File Storage (S3-compatible: Cloudflare R2 / DigitalOcean Spaces / other)
# ============================================
# Strategy pattern: both provider profiles below can be configured side by side.
# FILE_STORAGE_PROVIDER picks which one is active ("Local" | "S3" | "DigitalOcean") and can be
# changed live (no restart) - see FileStorageOptions/FileStorageProviderFactory.
FILE_STORAGE_PROVIDER=DigitalOcean

# --- "S3" profile (generic S3-compatible, e.g. Cloudflare R2) ---
# Endpoint: regional host only, no bucket, no protocol (e.g. d20e7b7dcbe13937cf5e101129a9dbb9.r2.cloudflarestorage.com)
S3_ENDPOINT=your-s3-endpoint-host
# Optional CDN hostname (bucket already in the host) used for public URLs instead of the endpoint above
S3_CDN_ENDPOINT=
# Region must match the provider's expected value for request signing; "auto" works for R2
S3_REGION=auto
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_USE_SSL=true
S3_BUCKET_NAME=beelogistics
# Optional prefix for object keys (e.g. test/ or prod/)
S3_OBJECT_KEY_PREFIX=

# --- "DigitalOcean" profile (DigitalOcean Spaces) ---
# Endpoint: regional host only, no bucket, no protocol (e.g. sgp1.digitaloceanspaces.com)
DIGITALOCEAN_ENDPOINT=your-digitalocean-endpoint-host
# Spaces CDN hostname (bucket already in the host), used for public URLs instead of the endpoint above
DIGITALOCEAN_CDN_ENDPOINT=
# Must match the Space's region (e.g. sgp1) - DigitalOcean validates this during request signing
DIGITALOCEAN_REGION=sgp1
DIGITALOCEAN_ACCESS_KEY=your-digitalocean-access-key
DIGITALOCEAN_SECRET_KEY=your-digitalocean-secret-key
DIGITALOCEAN_USE_SSL=true
DIGITALOCEAN_BUCKET_NAME=bee-dev
DIGITALOCEAN_OBJECT_KEY_PREFIX=

# ============================================
# ClamAV (virus scanning)
# ============================================
# ClamAV runs in the same compose; backend uses hostname "clamav" (Docker service name)
# No env overrides needed unless you use an external ClamAV host/port
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ============================================
# Liveness (face verification) - external service
# ============================================
# Liveness runs on a separate VM (YOLO container); dev/staging/prod all point to the same instance.
# Set LIVENESS_BASE_URL to your liveness service URL (e.g. http://your-liveness-vm:8000 or https://liveness.yourdomain.com).
# Set LIVENESS_ENABLED=false to disable when the service is not running.
LIVENESS_ENABLED=false
LIVENESS_BASE_URL=http://your-liveness-vm:8000
# LIVENESS_TIMEOUT_SECONDS=30
# LIVENESS_SESSION_EXPIRY_MINUTES=10

# ============================================
# Didit hosted KYC (driver onboarding: ID + selfie + liveness + face match)
# ============================================
# Create a workflow and get keys at https://business.didit.me (free tier: 500 sessions/month).
# Webhook URL to configure in the Didit console: https://<your-api-host>/api/webhooks/didit
DIDIT_ENABLED=false
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
# Brand-neutral sentinel intercepted in-WebView by both the driver and customer apps.
# DIDIT_CALLBACK_URL=beeapp://kyc-callback

# ============================================
# Per-shift face check (self-hosted InsightFace; see docker-compose.liveness.yml `facematch`)
# ============================================
# Enable FACEMATCH first; then SHIFTCHECK_SHADOW_MODE=true to log scores without blocking;
# finally SHIFTCHECK_ENABLED=true to enforce before drivers go online.
FACEMATCH_ENABLED=false
FACEMATCH_BASE_URL=http://your-liveness-vm:8001
# FACEMATCH_THRESHOLD=0.45
SHIFTCHECK_ENABLED=false
# SHIFTCHECK_MAX_AGE_HOURS=12
# SHIFTCHECK_SHADOW_MODE=false

# ============================================
# Matrix booking chat (self-hosted Synapse; see docker/synapse/README.md)
# ============================================
# Per-booking driver<->customer rooms. bee-backend is a Matrix APPLICATION SERVICE, not a client:
# it holds the tokens below and acts as namespaced users via ?user_id= masquerading.
#
# Ships OFF. With MATRIX_ENABLED=false nothing provisions rooms and booking creation behaves
# exactly as before, so local dev and CI need none of this.
MATRIX_ENABLED=false
# Where the backend reaches Synapse. Private-network hop, so plain HTTP on purpose.
# Synapse runs on its OWN VM with its OWN Postgres - see docker/synapse/README.md. Deployed
# environments point this at that VM (http://10.10.10.<x>:8008); the compose service name below
# is for local development only, where Synapse runs as a container beside the backend.
# Deployed: the Synapse VM. Local dev: the compose service name.
MATRIX_HOMESERVER_URL=http://10.10.10.152:8008
# The public HTTPS URL handed to client apps. Blank falls back to MATRIX_HOMESERVER_URL.
# Deployed environments get this from .gitlab-ci.yml (prepare:env:*).
MATRIX_PUBLIC_HOMESERVER_URL=
# The MXID domain - the part after the colon in @bee_u_prod_...:matrix.bee-app.tech. PERMANENT:
# baked into every user and room id ever created, so changing it is a reset, not a migration.
# ONE Synapse serves every environment, so this is the same value everywhere. It is the
# homeserver's own hostname, which means no /.well-known delegation is needed anywhere.
MATRIX_SERVER_NAME=matrix.bee-app.tech
# ISOLATION BOUNDARY, not a label. Prefixes every user and alias this environment creates:
# @bee_u_<prefix>_... and #booking-<prefix>-... . BookingNumber is unique only WITHIN a database
# and each environment has its own, so dev and prod can both mint BKG-20260823-000123 - and room
# creation adopts an existing alias rather than failing, which would drop a dev tester into a real
# customer's chat. Each prefix needs its own EXCLUSIVE appservice registration on the homeserver;
# Synapse then enforces the boundary server-side.
#   dev   prefix dev   id bee-appservice-dev   sender bee-dev
# Only dev is registered today. Other environments stay MATRIX_ENABLED=false until they have a
# prefix AND their own exclusive appservice registration on the homeserver.
MATRIX_ENVIRONMENT_PREFIX=
# AS_TOKEN and HS_TOKEN travel in opposite directions and MUST be different values. Generate with
# `openssl rand -hex 32` each. Deployed environments read them from Vault (bee/config); set them
# here only for a local Synapse.
MATRIX_AS_TOKEN=
MATRIX_HS_TOKEN=
# Synapse Admin API token, used only by the retention job to purge expired rooms.
MATRIX_ADMIN_TOKEN=
# Where the ADMIN API is reached. Blank falls back to MATRIX_HOMESERVER_URL, which is correct
# unless the admin path is blocked in front of Synapse. It is on bee-app.tech: /_synapse/* returns
# 404 from the reverse proxy while /_matrix/* is served, so room purging needs the host directly.
# Only PurgeRoomAsync uses this; all other traffic keeps MATRIX_HOMESERVER_URL.
MATRIX_ADMIN_API_URL=
# Must match the registration file for this environment on the homeserver.
MATRIX_APPSERVICE_ID=
MATRIX_SENDER_LOCALPART=
# MATRIX_TIMEOUT_SECONDS=20
# Hours after a booking completes/cancels before its room goes read-only.
# MATRIX_ROOM_FREEZE_DELAY_HOURS=24
# Days before a frozen room is purged from Synapse. The Postgres transcript is NOT affected.
# MATRIX_ROOM_RETENTION_DAYS=90

# ============================================
# Seq (structured logging)
# ============================================
# URL of your Seq instance (e.g. http://seq.yourdomain.com:80 or http://100.105.242.96:5341)
# Leave empty to disable Seq. Default when using same Docker network: http://beeapp-seq:80
SEQ_SERVER_URL=http://your-seq-vm:80

# ============================================
# GlitchTip (error monitoring)
# ============================================
# DSN for the self-hosted GlitchTip at https://glitchtip.ilocosscript.live (project 1).
# Format: https://<publicKey>@glitchtip.ilocosscript.live/1
#
# GlitchTip speaks the Sentry protocol, so the Sentry.* SDKs and every SENTRY_* name below
# are unchanged - only the endpoint moved. It replaced the self-hosted Sentry, which needed
# 65 containers and 20 GB against GlitchTip's 3 containers and ~1 GB.
#
# Deployed environments read this from Vault (bee/config -> Sentry__Dsn), so you normally
# leave this EMPTY. Setting it here overrides Vault, which is useful for pointing a single
# box at a different project without a Vault write.
# Leave EMPTY to disable error monitoring entirely - recommended for local dev and CI.
SENTRY_DSN=
# Release marker shown in GlitchTip. CI passes CI_COMMIT_SHORT_SHA automatically.
SENTRY_RELEASE=local

# ============================================
# Seeding Configuration
# ============================================
SEED_DEFAULT_PASSWORD=your_secure_seed_password_here

# ============================================
# Notes
# ============================================
# - Redis is automatically connected via docker-compose service name "redis:6379"
# - No REDIS_URL needed - it's hardcoded to use the Redis container in this compose file
# - Location, BookingSettings, Matching, ImageProcessing, FileUpload, RateLimit are hardcoded in docker-compose
# - ClamAV service name "clamav" is used by backend (same VM / same compose)
# - Liveness: set LIVENESS_BASE_URL to your VM where YOLO liveness runs; one instance for dev/staging/prod
